{
  "manifest_version": 3,
  "name": "Osprey",
  "description": "Hands your downloads to the Osprey download manager.",
  "version": "0.1.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["contextMenus", "cookies", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["rules.js", "background.js"], "persistent": false },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["rules.js", "video-button.js", "content.js"], "run_at": "document_start", "all_frames": true }
  ]
}
